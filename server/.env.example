# 云数据库 PostgreSQL 直连串（在云开发控制台 → 数据库 → PostgreSQL → 连接信息 获取）
# 格式：postgresql://用户名:密码@主机:端口/数据库名?sslmode=require
# 密码含 @ : / 等特殊字符时需做 URL 编码（@ -> %40）
DATABASE_URL="postgresql://user:password@host:5432/atlas?sslmode=require"
JWT_SECRET="please-change-me-to-a-long-random-string"
PORT=3001

# 大模型（Atlas · 旅行助手对话）
OPENAI_API_KEY=
# 可选，默认 gpt-4o-mini
OPENAI_MODEL=gpt-4o-mini
# 非 OpenAI 官方 Key 时必须设置兼容接口地址，例如：
# DeepSeek: OPENAI_BASE_URL=https://api.deepseek.com  OPENAI_MODEL=deepseek-chat
# 阿里云百炼: OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# OPENAI_TIMEOUT_MS=90000
# OPENAI_MAX_TOKENS=8192
