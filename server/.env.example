# SQLite 本地数据库文件；相对路径以 prisma/schema.prisma 所在目录为基准。
# Lighthouse 部署建议改为持久化的绝对路径，例如：file:/opt/atlas-data/atlas.db
DATABASE_URL="file:./atlas.db"
JWT_SECRET="please-change-me-to-a-long-random-string"
PORT=3001
NODE_ENV=development

# 生产环境默认同域访问，无需配置。若单独部署前端，可填写允许的 HTTPS 域名，多个域名以逗号分隔。
# CORS_ORIGIN=https://example.com

# 大模型（Atlas · 旅行助手对话）
OPENAI_API_KEY=
# 可选，默认 gpt-4o-mini
OPENAI_MODEL=gpt-4o-mini
# 非 OpenAI 官方 Key 时必须设置兼容接口地址，例如：
# DeepSeek: OPENAI_BASE_URL=https://api.deepseek.com  OPENAI_MODEL=deepseek-chat
# 阿里云百炼: OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# OPENAI_TIMEOUT_MS=90000
# OPENAI_MAX_TOKENS=8192

# CloudBase 生产部署建议设为 true：AI 只对已登录用户开放，并限制单个 IP 的调用频率。
# AI_REQUIRE_AUTH=false
# AI_RATE_LIMIT_MAX=60
# AI_RATE_LIMIT_WINDOW_MS=60000
